/* GoRide Application QSS Stylesheet */

QWidget {
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 13px;
    color: #1E293B;
    background-color: #F8FAFC;
}

/* Header Frame */
#headerFrame {
    background-color: #0F172A;
    border-bottom: 2px solid #2563EB;
    min-height: 56px;
    padding: 0 16px;
}

#logoLabel {
    font-size: 22px;
    font-weight: bold;
    color: #38BDF8;
    padding-right: 12px;
}

#greetingLabel {
    font-size: 14px;
    font-weight: 500;
    color: #0080ff;
}

#walletLabel {
    font-size: 14px;
    font-weight: bold;
    color: #FACC15;
    background-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 16px;
    padding: 6px 16px;
}

/* Sidebar Navigation */
#sidebarFrame {
    background-color: #1E293B;
    min-width: 200px;
    max-width: 220px;
    border-right: 1px solid #334155;
}

#sidebarFrame QPushButton {
    background-color: transparent;
    color: #94A3B8;
    border: none;
    border-radius: 6px;
    padding: 10px 16px;
    text-align: left;
    font-size: 14px;
    font-weight: 500;
    margin: 4px 8px;
}

#sidebarFrame QPushButton:hover {
    background-color: #334155;
    color: #F8FAFC;
}

#sidebarFrame QPushButton:checked, #sidebarFrame QPushButton[active="true"] {
    background-color: #2563EB;
    color: #FFFFFF;
    font-weight: bold;
}

#exitButton {
    background-color: #7F1D1D !important;
    color: #FECACA !important;
}

#exitButton:hover {
    background-color: #991B1B !important;
    color: #FFFFFF !important;
}

/* Booking Control Frame */
#bookingControlFrame {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
}

#bookingControlFrame QLabel {
    font-size: 13px;
    font-weight: 600;
    color: #334155;
}

#bookingControlFrame QComboBox {
    background-color: #F1F5F9;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 7px 28px 7px 10px;
    min-height: 24px;
    color: #0F172A;
}

#bookingControlFrame QComboBox:hover {
    border-color: #2563EB;
}

#bookingControlFrame QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
}

#bookingControlFrame QPushButton {
    padding: 9px 12px;
}

#bookingScrollArea QScrollBar:vertical {
    width: 10px;
}

/* Push Buttons */
QPushButton {
    background-color: #2563EB;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #1D4ED8;
}

QPushButton:pressed {
    background-color: #1E40AF;
}

QPushButton:disabled {
    background-color: #94A3B8;
    color: #CBD5E1;
}

#primaryButton {
    background-color: #10B981;
}

#primaryButton:hover {
    background-color: #059669;
}

#dangerButton {
    background-color: #EF4444;
}

#dangerButton:hover {
    background-color: #DC2626;
}

/* Fare & Distance Labels */
#distanceLabel, #estimatedFareLabel, #selectedDriverLabel {
    background-color: #F1F5F9;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    padding: 8px 12px;
    font-weight: bold;
    color: #0F172A;
}

#estimatedFareLabel {
    color: #2563EB;
    font-size: 15px;
}

#statusLabel {
    background-color: #0F172A;
    color: #38BDF8;
    font-weight: bold;
    padding: 8px 16px;
    border-top: 1px solid #1E293B;
}

/* QTableWidget */
QTableWidget {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    gridline-color: #E2E8F0;
    border-radius: 6px;
}

QTableWidget::item {
    padding: 8px;
    border-bottom: 1px solid #F1F5F9;
}

QHeaderView::section {
    background-color: #F1F5F9;
    color: #334155;
    font-weight: bold;
    padding: 8px;
    border: none;
    border-bottom: 2px solid #CBD5E1;
}

/* Cards & Content Panels */
.QFrame#cardFrame {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 16px;
}
